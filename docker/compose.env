# Non-secret development values for the compose environment. Never used on a real host.
NODE_ENV=production
SITE_URL=http://localhost:3019
PORT=3019
PAYLOAD_SECRET=compose-only-secret-not-for-real-use
DATABASE_URL=postgres://katsura:katsura@postgres:5432/katsura
DATABASE_MIGRATE_URL=postgres://katsura:katsura@postgres:5432/katsura
DATABASE_POOL_MAX=10
AUTH_MODE=local
READER_ACCESS=open
STORAGE_DRIVER=s3
S3_BUCKET=katsura-media
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=katsura
S3_SECRET_ACCESS_KEY=katsura-minio
S3_FORCE_PATH_STYLE=true
S3_CLIENT_UPLOADS=false
JOBS_TRIGGER=inprocess
JOBS_RUN_SECRET=compose-only
EMAIL_DRIVER=log
LEARNER_COOKIE_SECRET=compose-only-learner-secret
