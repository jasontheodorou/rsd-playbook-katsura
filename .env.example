# katsura environment. Copy to .env and fill in. Every host-specific choice is made here.
# Full explanation of each seam: docs/PORTABILITY.md

# ---- Site
SITE_URL=http://localhost:3019
PORT=3019

# ---- Payload
PAYLOAD_SECRET=change-me-long-random-string

# ---- Database (Postgres). Pooled string for runtime, direct string for migrations.
DATABASE_URL=postgres://katsura:katsura@127.0.0.1:5432/katsura
DATABASE_MIGRATE_URL=postgres://katsura:katsura@127.0.0.1:5432/katsura
DATABASE_POOL_MAX=5

# ---- Editorial auth: local (email + password, now) | trusted-header (later) | oidc (later)
AUTH_MODE=local

# ---- Reader access: open (dev) | passphrase (Vercel) | trusted (behind the company gate)
READER_ACCESS=open
READER_PASSPHRASE=

# ---- Media storage: local (disk, dev only) | s3 (any S3-compatible bucket: R2, S3, MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Browser uploads go straight to the bucket (needed on Vercel, whose request bodies cap at 4.5 MB)
S3_CLIENT_UPLOADS=true
# Public base for media URLs. Leave empty to serve through the app.
MEDIA_BASE_URL=

# ---- Background jobs: http (an external caller hits /api/jobs/run) | inprocess (long-running server)
JOBS_TRIGGER=http
JOBS_RUN_SECRET=change-me

# ---- Email: log (none; publish requests show in the admin) | smtp | resend
EMAIL_DRIVER=log

# ---- Learner progress cookie. Separate from PAYLOAD_SECRET. Rotating it orphans anonymous learners.
LEARNER_COOKIE_SECRET=change-me-too
